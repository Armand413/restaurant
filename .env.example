# Configuration locale : remplacez les trois valeurs ci-dessous, ne partagez pas vos secrets.
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
CORS_ORIGIN=http://localhost:8787
OPENAPI_ENABLED=false

# Déploiement HTTPS : domaine réel du serveur et e-mail des certificats.
PUBLIC_HOST=restaurant.example.org
ACME_EMAIL=admin@example.org
PUBLIC_API_URL=https://restaurant.example.org

# Application Meta officielle et configuration Embedded Signup actuelle avec coexistence.
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_API_VERSION=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_DEFAULT_LANGUAGE=fr
# Clé serveur distincte : 32 octets aléatoires encodés en Base64. Ne jamais la modifier sans rechiffrer les jetons.
WHATSAPP_TOKEN_ENCRYPTION_KEY=

# Mode manuel / numéro de test officiel seulement. Embedded Signup stocke ses identifiants chiffrés en base.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
